# Server Configuration
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# CORS Allowed Origins (comma-separated)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Database (PostgreSQL)
